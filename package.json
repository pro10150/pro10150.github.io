{
  "name": "web-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://www.noppakunanantakitthawon.com",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-data.mjs",
    "predeploy": "npm run check && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "vite": "^6.0.0"
  }
}
